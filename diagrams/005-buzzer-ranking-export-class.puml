@startuml
title 005 搶答公平順位與 CSV 匯出 - 類別圖

class ActivitySettings {
  fairnessEnabled: Boolean
  delayPerWin: Duration
  phase: ActivityPhase
}

class Team {
  teamId: Identifier
  displayName: Text
}

class Question {
  questionNumber: Text
  sequence: Integer
}

class AcceptedAnswer {
  answer: AnswerContent
  receivedAt: ServerTime
  acceptedOrder: Integer
  priorWinCountSnapshot: Integer
  effectiveTime: ServerTime
  rank: Integer
}

class QuestionResult {
  successfulTeam: Team
  successfulAnswer: AnswerContent
  rankedAnswers: List<AcceptedAnswer>
}

class CsvResultRow {
  questionNumber: Text
  successfulGroup: Text
  successfulAnswer: AnswerContent
  group: Text
  groupAnswer: AnswerContent
  rank: Integer
}

ActivitySettings "1" -- "*" Question : configures
Team "1" -- "*" AcceptedAnswer : submits
Question "1" -- "*" AcceptedAnswer : receives
Question "1" -- "1" QuestionResult : determines
QuestionResult "1" o-- "*" AcceptedAnswer : orders
QuestionResult ..> CsvResultRow : exported as
@enduml
