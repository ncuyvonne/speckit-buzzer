TEACHER_PASSWORD=replace-with-local-password
GROUP_IDS=1,2,3

# Backend-only service account JSON for Google Sheets API access; keep empty in this example.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Disposable, non-classroom spreadsheet for the Guided Notes API proof of concept.
GUIDED_NOTES_POC_SPREADSHEET_URL=
# Worksheet tab name in the disposable proof-of-concept spreadsheet.
GUIDED_NOTES_POC_WORKSHEET_TITLE=
# Scratch range within that worksheet; only this range may be changed and restored.
GUIDED_NOTES_POC_SCRATCH_RANGE=
